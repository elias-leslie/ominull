#!/usr/bin/env bash
# Deployment hook used by scripts/release.sh. Copy this file to the ignored
# scripts/deploy_remote.sh and fill in deployment-specific values there.
#
# The hub hop is package-manager-owned: the hub .deb is installed with dpkg,
# while signed agent packages are published into the hub's download directory.
# No privileged binary or service file is copied into the container.
set -euo pipefail

PROXMOX_HOST="${OMINULL_PROXMOX_HOST:?set OMINULL_PROXMOX_HOST in the ignored deployment hook}"
LXC_VMID="${OMINULL_HUB_LXC_VMID:?set OMINULL_HUB_LXC_VMID in the ignored deployment hook}"
LXC_IP="${OMINULL_HUB_IP:?set OMINULL_HUB_IP in the ignored deployment hook}"
REMOTE_BIN_DIR="/opt/ominull/bin"

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="${OMINULL_RELEASE_VERSION:-$("${ROOT_DIR}/scripts/version.sh" show)}"
DIST_DIR="${ROOT_DIR}/dist"

required=(
    "ominull-hub_${VERSION}_amd64.deb"
    "ominull-hub_${VERSION}_amd64.deb.sig"
    "ominull-hub_${VERSION}_amd64.deb.sha256"
    "ominull-agent_${VERSION}_amd64.deb"
    "ominull-agent_${VERSION}_amd64.deb.sig"
    "ominull-agent_${VERSION}_amd64.deb.sha256"
    "ominull-agent_${VERSION}_amd64.deb.release.sig"
    "ominull-agent-windows-${VERSION}.msi"
    "ominull-agent-windows-${VERSION}.msi.sig"
    "ominull-agent-windows-${VERSION}.msi.sha256"
    "ominull-agent-windows-${VERSION}.msi.release.sig"
)
for file in "${required[@]}"; do
    [ -f "${DIST_DIR}/${file}" ] || { echo "[-] Missing dist/${file}; build and sign first." >&2; exit 1; }
done

remote_tmp="$(ssh "${PROXMOX_HOST}" "mktemp -d /tmp/ominull-release-${VERSION}.XXXXXX")"
cleanup() {
    local file
    for file in "${required[@]}"; do
        ssh "${PROXMOX_HOST}" "rm -f -- '${remote_tmp}/${file}'" >/dev/null 2>&1 || true
    done
    ssh "${PROXMOX_HOST}" "rmdir -- '${remote_tmp}'" >/dev/null 2>&1 || true
}
trap cleanup EXIT

echo "[*] Staging signed hub package and retained artifacts in LXC ${LXC_VMID}."
for file in "${required[@]}"; do
    scp "${DIST_DIR}/${file}" "${PROXMOX_HOST}:${remote_tmp}/${file}"
done

# Install the hub through dpkg before restarting it. The package's postinst
# owns the service and preserves the database, PKI, and hub environment file.
ssh "${PROXMOX_HOST}" "pct push '${LXC_VMID}' '${remote_tmp}/ominull-hub_${VERSION}_amd64.deb' '/tmp/ominull-hub_${VERSION}.deb'"
ssh "${PROXMOX_HOST}" "pct exec '${LXC_VMID}' -- dpkg -i '/tmp/ominull-hub_${VERSION}.deb' && rm -f '/tmp/ominull-hub_${VERSION}.deb'"

# Publish only signed allow-listed release artifacts. The package file is not
# the running binary; it is the immutable input served to endpoint updaters.
ssh "${PROXMOX_HOST}" "pct exec '${LXC_VMID}' -- install -d -o root -g root -m 0755 '${REMOTE_BIN_DIR}'"
for file in "${required[@]}"; do
    ssh "${PROXMOX_HOST}" "pct push '${LXC_VMID}' '${remote_tmp}/${file}' '${REMOTE_BIN_DIR}/${file}'"
done
ssh "${PROXMOX_HOST}" "pct exec '${LXC_VMID}' -- systemctl restart ominull-hub.service"

# systemctl restart returns before the new hub listens, so the first probe used
# to hit a closed port. Wait (bounded) for the unit to be active and :9443 to
# listen, then require the hub to answer as the version just installed and to
# serve the authenticated API. Anything short of that inside the window fails.
: "${OMINULL_ADMIN_KEY:?set OMINULL_ADMIN_KEY}"
# The admin key only travels over TLS (the hub's :9443 listener), checked
# against the hub CA that enrolment pins on every agent.
HUB_CA="${OMINULL_HUB_CA:-/etc/ominull/ca.crt}"
[ -f "${HUB_CA}" ] || { echo "[-] Hub CA ${HUB_CA} is missing; set OMINULL_HUB_CA." >&2; exit 1; }
hdr() {
    printf 'header = "X-API-Key: %s"\n' "${OMINULL_ADMIN_KEY}"
}
deadline=$((SECONDS + 60))
until ssh "${PROXMOX_HOST}" "pct exec '${LXC_VMID}' -- sh -c 'systemctl is-active --quiet ominull-hub.service && ss -Hltn \"sport = :9443\" | grep -q .'"; do
    if [ "${SECONDS}" -ge "${deadline}" ]; then
        echo "[-] ominull-hub.service is not active and listening on :9443 within 60 s of the restart." >&2
        exit 1
    fi
    sleep 1
done
while :; do
    # The console page needs the key too; each curl reads its own descriptor.
    exec 3< <(hdr) 4< <(hdr)
    if curl -fsS --max-time 5 --cacert "${HUB_CA}" -K /dev/fd/4 "https://${LXC_IP}:9443/" 2>/dev/null | grep -qF "app.css?v=${VERSION}\"" &&
        status="$(curl -fsS --max-time 5 --cacert "${HUB_CA}" -K /dev/fd/3 "https://${LXC_IP}:9443/api/v1/hierarchy" 2>/dev/null)" &&
        printf '%s' "${status}" | jq -e . >/dev/null 2>&1; then
        echo "[+] Hub package v${VERSION} is live: unit active, :9443 listening, console reports v${VERSION}, API answering."
        exit 0
    fi
    if [ "${SECONDS}" -ge "${deadline}" ]; then
        echo "[-] Hub did not answer as v${VERSION} with a healthy API within 60 s of the restart." >&2
        exit 1
    fi
    sleep 1
done
