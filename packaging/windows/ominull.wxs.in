<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Ominull Agent" Language="1033" Version="@VERSION@"
           Manufacturer="Ominull Project" UpgradeCode="{A7CFC41E-3A9C-4B5B-9DF6-0A9E2BF05D1D}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer Ominull Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Ominull">
          <Component Id="AgentFiles" Guid="*">
            <File Id="AgentExe" Source="@AGENT_EXE@" KeyPath="yes" />
            <File Id="WfpExe" Source="@WFP_EXE@" />
            <File Id="ScreenHelperExe" Source="@SCREEN_HELPER_EXE@" />
            <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\OminullAgent">
              <RegistryValue Name="DisplayName" Type="string" Value="Ominull Agent" KeyPath="no" />
              <RegistryValue Name="DisplayVersion" Type="string" Value="@VERSION@" KeyPath="no" />
            </RegistryKey>
            <ServiceInstall Id="AgentServiceInstall" Type="ownProcess" Name="ominulld"
                            DisplayName="Ominull Threat Nullification Service" Start="auto"
                            ErrorControl="normal" Vital="yes" Account="LocalSystem"
                            Arguments="--service --config &quot;[CommonAppDataFolder]Ominull\agent.conf&quot;" />
            <!-- A clean MSI has no enrolled config yet. Bootstrap starts the
                 registered service after package-owned enrollment; self-update
                 starts it after its MSI transaction returns. Starting here
                 makes every clean install fail with SCM error 1920, so an
                 enrolled machine is started by StartIfEnrolled below. -->
            <ServiceControl Id="AgentServiceControl" Name="ominulld"
                            Stop="both" Remove="uninstall" Wait="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="Ominull Agent" Level="1">
      <ComponentRef Id="AgentFiles" />
    </Feature>

    <CustomAction Id="ClearWfp" FileKey="WfpExe" ExeCommand="uninstall"
                  Execute="deferred" Return="check" Impersonate="no" />
    <!-- An MSI run by hand on an enrolled machine stops the service and would leave
         it stopped. A start failure must not undo the install, and the service
         already running is fine for the updater and bootstrap that follow. -->
    <Property Id="CMDEXE" Value="cmd.exe" />
    <CustomAction Id="StartIfEnrolled" Property="CMDEXE"
                  ExeCommand="/c if exist &quot;[CommonAppDataFolder]Ominull\agent.conf&quot; sc.exe start ominulld"
                  Execute="deferred" Return="ignore" Impersonate="no" />
    <InstallExecuteSequence>
      <!-- MajorUpgrade uninstalls the old product as part of the same
           transaction. Do not purge ProgramData identity during that leg;
           the new MSI must inherit the enrolled endpoint. wixl places a
           Before= action right after the previous one it knows, which here was
           outside the install script: every uninstall then failed with 2762. -->
      <Custom Action="ClearWfp" After="DeleteServices">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND NOT REINSTALL</Custom>
      <Custom Action="StartIfEnrolled" After="StartServices">NOT REMOVE="ALL"</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
