#!/bin/sh
set -eu

case "${1:-}" in
remove|purge)
    if [ -d /run/systemd/system ]; then
        systemctl stop ominull-response-authority.service || true
        systemctl disable ominull-response-authority.service || true
        systemctl stop ominull-hub.service || true
        systemctl disable ominull-hub.service || true
    fi
    ;;
esac
