#!/bin/sh
set -eu

for directory in /etc/ominull /var/lib/ominull /var/lib/ominull/grants /var/lib/ominull/packages /var/lib/ominull/backups /opt/ominull/bin/certs; do
    [ -L "${directory}" ] && { echo "ominull: refusing symlinked package directory ${directory}" >&2; exit 1; }
    [ -e "${directory}" ] && [ ! -d "${directory}" ] && { echo "ominull: package path ${directory} is not a directory" >&2; exit 1; }
done

# 1. Create dedicated unprivileged system group and user for hub
if ! grep -q '^ominull:' /etc/group 2>/dev/null; then
    if command -v groupadd >/dev/null 2>&1; then
        groupadd -r ominull 2>/dev/null || true
    fi
    if ! grep -q '^ominull:' /etc/group 2>/dev/null; then
        echo "ominull:x:998:" >> /etc/group 2>/dev/null || true
    fi
fi
if ! grep -q '^ominull:' /etc/passwd 2>/dev/null; then
    if command -v useradd >/dev/null 2>&1; then
        useradd -r -g ominull -d /var/lib/ominull -s /usr/sbin/nologin -c "Ominull Fleet Management Hub" ominull 2>/dev/null || true
    fi
    if ! grep -q '^ominull:' /etc/passwd 2>/dev/null; then
        echo "ominull:x:998:998:Ominull Fleet Management Hub:/var/lib/ominull:/usr/sbin/nologin" >> /etc/passwd 2>/dev/null || true
    fi
fi


# 3. Directory layout and permissions
install -d -m 0750 /etc/ominull
chown root:ominull /etc/ominull 2>/dev/null || true

# Hub state
install -d -m 0700 /var/lib/ominull /var/lib/ominull/packages /var/lib/ominull/backups /opt/ominull/bin/certs
chown -R ominull:ominull /var/lib/ominull 2>/dev/null || true
chmod 0700 /var/lib/ominull
if [ -d /opt/ominull/bin/certs ]; then
    chown -R ominull:ominull /opt/ominull/bin/certs 2>/dev/null || true
    chmod 0700 /opt/ominull/bin/certs
fi

# Grant signing keys, epochs and manifests.
install -d -m 0700 /var/lib/ominull/grants
chown -R ominull:ominull /var/lib/ominull/grants 2>/dev/null || true
chmod 0700 /var/lib/ominull/grants

# 4. Configuration files
# hub.env and admin.key are root:ominull 0640: the hub reads them and cannot
# rewrite them, so a compromised hub cannot repoint its own binary directory,
# TLS paths or credential for the next start.
[ -L /etc/ominull/admin.key ] && { echo "ominull: refusing symlinked /etc/ominull/admin.key" >&2; exit 1; }
[ -L /etc/ominull/hub.env ] && { echo "ominull: refusing symlinked /etc/ominull/hub.env" >&2; exit 1; }
[ -e /etc/ominull/admin.key ] && [ ! -f /etc/ominull/admin.key ] && { echo "ominull: /etc/ominull/admin.key is not a regular file" >&2; exit 1; }
[ -e /etc/ominull/hub.env ] && [ ! -f /etc/ominull/hub.env ] && { echo "ominull: /etc/ominull/hub.env is not a regular file" >&2; exit 1; }

if [ ! -s /etc/ominull/admin.key ]; then
    umask 077
    openssl rand -hex 32 > /etc/ominull/admin.key
    chown root:ominull /etc/ominull/admin.key 2>/dev/null || true
    chmod 0640 /etc/ominull/admin.key
fi
chown root:ominull /etc/ominull/admin.key 2>/dev/null || true
chmod 0640 /etc/ominull/admin.key

if [ ! -s /etc/ominull/hub.env ]; then
    umask 077
    cat > /etc/ominull/hub.env <<'OMINULL_ENV'
# Managed by ominullctl and the Ominull setup wizard. Do not edit.
OMINULL_DB=/var/lib/ominull/ominull.db
OMINULL_ADMIN_KEY_FILE=/etc/ominull/admin.key
OMINULL_BINARY_DIR=/opt/ominull/bin
OMINULL_SETUP_TOKEN_FILE=/var/lib/ominull/setup.token
OMINULL_LISTEN=:9999
OMINULL_TLS_LISTEN=:9443
OMINULL_CONSOLE_TLS_LISTEN=:8443
OMINULL_CONSOLE_HOSTNAME=hub.lan
OMINULL_CLIENT_CERTS=optional
OMINULL_AGENT_VERSION=@VERSION@
OMINULL_ENV
    chown root:ominull /etc/ominull/hub.env 2>/dev/null || true
    chmod 0640 /etc/ominull/hub.env
fi
chown root:ominull /etc/ominull/hub.env 2>/dev/null || true
chmod 0640 /etc/ominull/hub.env

# Migrate legacy admin key if present
if grep -q '^OMINULL_ADMIN_KEY=' /etc/ominull/hub.env; then
    legacy_admin_key="$(sed -n 's/^OMINULL_ADMIN_KEY=//p' /etc/ominull/hub.env | head -n 1)"
    if [ -n "${legacy_admin_key}" ]; then
        umask 077
        printf '%s\n' "${legacy_admin_key}" > /etc/ominull/admin.key
        chown root:ominull /etc/ominull/admin.key 2>/dev/null || true
        chmod 0640 /etc/ominull/admin.key
    fi
    sed -i '/^OMINULL_ADMIN_KEY=/d' /etc/ominull/hub.env
fi
if ! grep -q '^OMINULL_ADMIN_KEY_FILE=' /etc/ominull/hub.env; then
    printf '%s\n' 'OMINULL_ADMIN_KEY_FILE=/etc/ominull/admin.key' >> /etc/ominull/hub.env
fi

# OMINULL_AGENT_VERSION is not a setting - it is the agent release bundled with
# *this* package, and it decides three things: which agent the hub offers to an
# outdated endpoint, the ?v= query the console requests its assets with, and the
# service worker's cache name. The block above writes it only when hub.env does
# not exist, so on every upgrade since the first install it kept the version
# that first installed the hub: a 1.8.4 hub served app.js?v=1.8.3 out of a cache
# keyed on 1.8.3, and offered the fleet an agent it no longer bundled. Rewrite it
# to track the package on every install, and leave every other line alone.
if grep -q '^OMINULL_AGENT_VERSION=' /etc/ominull/hub.env; then
    sed -i 's/^OMINULL_AGENT_VERSION=.*/OMINULL_AGENT_VERSION=@VERSION@/' /etc/ominull/hub.env
else
    printf '%s\n' 'OMINULL_AGENT_VERSION=@VERSION@' >> /etc/ominull/hub.env
fi

# 5. Distribute downloaded package artifacts
if [ -d /usr/share/ominull/packages ]; then
    install -d -o root -g root -m 0755 /opt/ominull/bin
    for artifact in /usr/share/ominull/packages/ominull-agent_*.deb \
                    /usr/share/ominull/packages/ominull-agent_*.deb.sig \
                    /usr/share/ominull/packages/ominull-agent_*.deb.sha256 \
                    /usr/share/ominull/packages/ominull-agent_*.deb.release.sig \
                    /usr/share/ominull/packages/ominull-agent-windows-*.msi \
                    /usr/share/ominull/packages/ominull-agent-windows-*.msi.sig \
                    /usr/share/ominull/packages/ominull-agent-windows-*.msi.sha256 \
                    /usr/share/ominull/packages/ominull-agent-windows-*.msi.release.sig; do
        [ -f "${artifact}" ] || continue
        install -o root -g root -m 0644 "${artifact}" /opt/ominull/bin/"$(basename "${artifact}")"
    done
fi

# 6. Service lifecycle management
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable ominull-hub.service
    systemctl try-restart ominull-hub.service || systemctl start ominull-hub.service || true
fi
