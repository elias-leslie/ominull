#!/bin/sh
set -eu

install -d -o root -g root -m 0755 /etc/ominull /var/lib/ominull/packages
install -d -o root -g root -m 0700 /var/lib/ominull
if [ ! -e /etc/ominull/hub.env ]; then
    install -o root -g root -m 0600 /dev/null /etc/ominull/hub.env
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
	systemctl enable ominull-hub.service
    if [ -s /etc/ominull/hub.env ]; then
        systemctl try-restart ominull-hub.service || systemctl start ominull-hub.service
    fi
fi
