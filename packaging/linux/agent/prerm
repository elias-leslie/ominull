#!/bin/sh
set -eu

case "${1:-}" in
remove|purge)
    if [ -d /run/systemd/system ]; then
        systemctl stop ominull-agent.service || true
        systemctl disable ominull-agent.service || true
    fi
    if [ -x /opt/ominull/bin/ominulld ]; then
        # Removal goes on either way, but the owner has to hear about rules left behind.
        /opt/ominull/bin/ominulld --cleanup || echo "[-] Ominull firewall rules may still be on this host: iptables -S | grep -i ominull" >&2
    fi
    ;;
esac
